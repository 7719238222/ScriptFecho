local function atualizarTextoToggle()
    toggleButton.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    toggleButton.BackgroundColor3 = espEnabled and Color3.fromRGB(30, 90, 30) or Color3.fromRGB(40, 40, 40)
end

local function limparESP(p)
    if espCache[p] then
        local dados = espCache[p]
        if dados.Texto then
            dados.Texto.Visible = false
            if dados.Texto.Remove then dados.Texto:Remove() end
        end
        if dados.Render then
            dados.Render:Disconnect()
        end

        if p.Character then
            local hl = p.Character:FindFirstChild("ESPHighlight")
            if hl then hl:Destroy() end
        end

        espCache[p] = nil
    end
end

local function checarInvisibilidade(cr)
    for _, obj in ipairs(cr:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
            if obj.Transparency < 0.9 then return false end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            if obj.Transparency < 0.9 then return false end
        end
    end

    return true
end

local function esp(p, cr)
    if not espEnabled then return end
    if espCache[p] then return end

    local h = cr:WaitForChild("Humanoid", 5)
    local head = cr:WaitForChild("Head", 5)
    if not h or not head then return end

    local text = Drawing.new("Text")
    text.Visible = false
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Font = 3
    text.Size = 16
    text.Color = Color3.fromRGB(170, 170, 170)

    espCache[p] = {
        Texto = text,
        Render = nil
    }

    espCache[p].Render = RunService.RenderStepped:Connect(function()
        if not espEnabled then
            limparESP(p)
            return
        end

        if not p or not p.Parent or not cr or not cr.Parent or not head or not head.Parent or h.Health <= 0 then
            limparESP(p)
            return
        end

        local head_pos, head_onscreen = Camera:WorldToViewportPoint(head.Position)

        if head_onscreen then
            text.Position = Vector2.new(head_pos.X, head_pos.Y - 27)

            local isInvis = checarInvisibilidade(cr)
            local hl = cr:FindFirstChild("ESPHighlight")

            if isInvis then
                text.Text = "[ INVISÍVEL | " .. p.Name .. " ]"
                text.Color = Color3.fromRGB(255, 60, 60)

                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "ESPHighlight"
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                    hl.Parent = cr
                end
            else
                text.Text = "[ " .. p.Name .. " ]"
                text.Color = Color3.fromRGB(170, 170, 170)

                if hl then hl:Destroy() end
            end

            text.Visible = true
        else
            text.Visible = false
        end
    end)
end

local function p_added(p)
    if p == LocalPlayer then return end

    if p.Character then
        task.spawn(function()
            if espEnabled then
                esp(p, p.Character)
            end
        end)
    end

    p.CharacterAdded:Connect(function(cr)
        task.spawn(function()
            if espEnabled then
                esp(p, cr)
            end
        end)
    end)
end

local function atualizarTodos()
    if espEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                esp(p, p.Character)
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                limparESP(p)
            end
        end
    end
end

toggleButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    atualizarTextoToggle()
    atualizarTodos()
end)

closeButton.MouseButton1Click:Connect(function()
    menuOpen = false
    main.Visible = false
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.K then
        menuOpen = not menuOpen
        main.Visible = menuOpen
    end
end)

for _, p in ipairs(Players:GetPlayers()) do
    p_added(p)
end

Players.PlayerAdded:Connect(p_added)
Players.PlayerRemoving:Connect(limparESP)

atualizarTextoToggle()
